#!/usr/bin/env python3
"""Count actual glfwSwapBuffers calls in three versions of E00."""
from pathlib import Path
from tempfile import TemporaryDirectory
import shutil
import subprocess as sp

base = Path(__file__).resolve().parent
origin = base / 'silnik-3d.bundle' if (base / 'silnik-3d.bundle').exists() else base
cmake = '''cmake_minimum_required(VERSION 3.20)
project(SwapProbe LANGUAGES C CXX)
set(CMAKE_CXX_STANDARD 17)
set(GLFW_BUILD_EXAMPLES OFF)
set(GLFW_BUILD_TESTS OFF)
set(GLFW_BUILD_DOCS OFF)
add_subdirectory("${ENGINE}/vendor/glfw" glfw)
add_executable(swaps swaps.cpp "${ENGINE}/vendor/glad/src/gl.c")
target_include_directories(swaps PRIVATE "${ENGINE}" "${ENGINE}/vendor/glad/include")
target_link_libraries(swaps PRIVATE glfw)
'''
def run(args, **options):
    return sp.run(args, check=True, **options)
with TemporaryDirectory(prefix='swap-probe-') as scratch:
    root = Path(scratch)
    tree = root / 'engine'
    driver = root / 'driver'
    driver.mkdir()
    shutil.copy2(base / 'swaps.cpp', driver)
    (driver / 'CMakeLists.txt').write_text(cmake)
    run(['git','clone','-q','--no-checkout',origin,tree])
    for tag, expected in [('ep00-one-frame',1),('ep00-draw-loop',8),('ep00-window',8)]:
        run(['git','-C',tree,'switch','-q','--detach',tag])
        build = root / tag
        run(['cmake','-S',driver,'-B',build,'-G','Ninja','-DENGINE='+str(tree)],stdout=sp.DEVNULL)
        run(['cmake','--build',build],stdout=sp.DEVNULL)
        result = run([build/'swaps'],capture_output=True,text=True,timeout=15)
        print(tag, result.stdout, sep='\n',flush=True)
        if f'swaps = {expected}\nexit 0\n' not in result.stdout:
            raise SystemExit(f'Unexpected swap count at {tag}')
