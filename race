#!/usr/bin/env python3
"""Measure one jump at the selected render rate against the 240 FPS control."""
import argparse
from pathlib import Path
import subprocess
import sys

parser=argparse.ArgumentParser(description=__doc__)
parser.add_argument('fps',type=int)
parser.add_argument('--version',default='.',help='checkpoint tag, or . for the current engine directory')
args=parser.parse_args()
if not 1<=args.fps<=1000:parser.error('FPS must be in 1..1000')
base=Path(__file__).resolve().parent
print('FPS    peak    first contact (s)',flush=True)
for hz in dict.fromkeys((args.fps,240)):
    subprocess.run([sys.executable,base/'probe',args.version,str(hz),'--hold-first-landing'],check=True)
