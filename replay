#!/usr/bin/env python3
"""Repeat each episode's measured before/after experiment from this Git checkout."""
import argparse
import os
import shutil
import subprocess
import sys
from pathlib import Path
from tempfile import TemporaryDirectory

base=Path(__file__).resolve().parent
parser=argparse.ArgumentParser(description=__doc__)
parser.add_argument('episode',choices=('00','01','02'))
ep=parser.parse_args().episode

def run(args,cwd=None):
    subprocess.run(args,cwd=cwd,check=True)

if ep in ('00','01'):
    build_env=os.environ.copy()
    configured=build_env.get('CMAKE_BIN_DIR')
    installed=Path('/opt/homebrew/share/android-commandlinetools/cmake/3.22.1/bin')
    if configured or ((not shutil.which('cmake') or not shutil.which('ninja')) and (installed/'cmake').exists() and (installed/'ninja').exists()):
        build_env['PATH']=str(configured or installed)+os.pathsep+build_env.get('PATH','')
    trials=([(tag,'arg') for tag in ('ep00-frozen','ep00-fast','ep00')] if ep=='00' else
            [(tag,rate) for tag in ('ep01-variable','ep01-per-frame','ep01-single-step','ep01') for rate in ('30','240')])
    if ep=='01':
        print('FPS   peak height   first landing (−1 = none)',flush=True)
        trials=[('ep01-no-update','30'),('ep01-launch','30'),*trials]
    for tag,arg in trials:
        print(f'\n$ ./probe {tag} {arg}',flush=True)
        subprocess.run([sys.executable,base/'probe',tag,arg],env=build_env,check=True)
    if ep=='01':
        with TemporaryDirectory(prefix='clock-trace-') as temp:
            work=Path(temp)
            tree=work/'engine'
            run(['git','clone','-q','--no-checkout',base,tree])
            for tag in ('ep01-single-step','ep01'):
                run(['git','-C',tree,'switch','-q','--detach',tag])
                print(f'\n{tag} · 30 FPS',flush=True)
                print('frame  carried_ms  before_step_ms  steps  remaining_ms',flush=True)
                run(['c++','-std=c++17','-I',tree,base/'clock-trace.cpp','-o',work/'trace'])
                run([work/'trace'])
else:
    with TemporaryDirectory(prefix='silnik-test-') as work:
        repo=Path(work)/'silnik'
        run(['git','clone','-q',base,repo])
        for tag in ('ep02-euler','ep02-quat-euler','ep02'):
            print(f'\n$ git switch --detach {tag}',flush=True)
            run(['git','switch','-q','--detach',tag],repo)
            print('$ c++ -std=c++17 axes.cpp -o axes',flush=True)
            run(['c++','-std=c++17','axes.cpp','-o','axes'],repo)
            for angle in (('60','90') if tag=='ep02-euler' else ('90',)):
                print(f'$ ./axes {angle}',flush=True)
                run([repo/'axes',angle],repo)
