#!/usr/bin/env python3
"""Repeat each episode's measured before/after experiment from this Git checkout."""
import argparse
import os
import shutil
import subprocess
import sys
from pathlib import Path
from tempfile import TemporaryDirectory

base=Path(__file__).resolve().parent
parser=argparse.ArgumentParser(description=__doc__)
parser.add_argument('episode',choices=('00','01','02','setup','edges','turns','pulse','clock','race','frame','corners','landing','steps'))
parser.add_argument('--source',type=Path,help='For landing, steps, turns, edges or pulse: compile the code from this edited engine directory.')
args=parser.parse_args()
ep=args.episode
if args.source and ep not in ('steps','landing','pulse','turns','edges'):
    parser.error('--source is available for landing, steps, turns, edges and pulse.')

def run(args,cwd=None):
    subprocess.run(args,cwd=cwd,check=True)

if ep=='setup':
    run([sys.executable,base/'probe-setup'])
elif ep in ('00','01'):
    build_env=os.environ.copy()
    configured=build_env.get('CMAKE_BIN_DIR')
    installed=Path('/opt/homebrew/share/android-commandlinetools/cmake/3.22.1/bin')
    if configured or ((not shutil.which('cmake') or not shutil.which('ninja')) and (installed/'cmake').exists() and (installed/'ninja').exists()):
        build_env['PATH']=str(configured or installed)+os.pathsep+build_env.get('PATH','')
    if ep=='01':
        subprocess.run([sys.executable,base/'probe-scissor'],env=build_env,check=True)
    if ep=='00':
        subprocess.run([sys.executable,base/'probe-swaps'],env=build_env,check=True)
    trials=([(tag,'arg') for tag in ('ep00-frozen','ep00-fast','ep00')] if ep=='00' else
            [(tag,rate) for tag in ('ep01-variable','ep01-per-frame','ep01-single-step','ep01') for rate in ('30','240')])
    if ep=='01':
        run([sys.executable,__file__,'landing'])
        print('FPS   peak height   first landing (−1 = none)',flush=True)
        trials=[('ep01-no-update','30'),('ep01-launch','30'),*trials]
    for tag,arg in trials:
        print(f'\n$ ./probe {tag} {arg}',flush=True)
        subprocess.run([sys.executable,base/'probe',tag,arg],env=build_env,check=True)
    if ep=='01':
        with TemporaryDirectory(prefix='clock-trace-') as temp:
            work=Path(temp)
            tree=work/'engine'
            run(['git','clone','-q','--no-checkout',base,tree])
            for tag in ('ep01-single-step','ep01'):
                run(['git','-C',tree,'switch','-q','--detach',tag])
                print(f'\n{tag} · 30 FPS',flush=True)
                print('frame  carried_ms  before_step_ms  steps  remaining_ms',flush=True)
                run(['c++','-std=c++17','-I',tree,base/'clock-trace.cpp','-o',work/'trace'])
                run([work/'trace'])
elif ep=='steps':
    tags=['.'] if args.source else ['ep01-inline-guard','ep01-inline-bank','ep01-inline-loop','ep01']
    for tag in tags:
        print(tag,flush=True)
        for hz in ('30','240'):
            run([sys.executable,base/'probe',tag,hz,'--count-steps'],cwd=args.source)
    if not args.source:
        origin=base/'silnik-3d.bundle' if (base/'silnik-3d.bundle').is_file() else base
        with TemporaryDirectory(prefix='clock-boundary-') as temp:
            work=Path(temp)
            repo=work/'ref'
            run(['git','clone','-q','-b','ep01',origin,repo])
            run(['c++','-std=c++17','-I',repo,base/'boundary-clock.cpp','-o',work/'trace'])
            print('Clock at the 2.000000 s boundary and on the following frame',flush=True)
            run([work/'trace'])
elif ep=='landing':
    origin=base/'silnik-3d.bundle' if (base/'silnik-3d.bundle').is_file() else base
    with TemporaryDirectory(prefix='jump-floor-') as scratch:
        work=Path(scratch)
        def sample(repo,label):
            print(label+'\nframe    height     speed',flush=True)
            run(['c++','-std=c++17','-I',repo,'-I',repo/'vendor/glad/include',
                 '-I',repo/'vendor/glfw/include',base/'landing-trace.cpp','-o',work/'landing'])
            run([work/'landing'])
        if args.source:
            repo=args.source.resolve()
            if not (repo/'frame.hpp').is_file():parser.error('Expected frame.hpp in '+str(repo))
            sample(repo,str(repo))
        else:
            repo=work/'ref'
            run(['git','clone','-q','--no-checkout',origin,repo])
            for tag in ('ep01-fall','ep01-clamp','ep01-bounce'):
                run(['git','-C',repo,'switch','-q','--detach',tag])
                sample(repo,tag)
elif ep=='frame':
    bundle = base / 'silnik-3d.bundle'
    with TemporaryDirectory(prefix='one-frame-') as work:
        tree = Path(work) / 'engine'
        run(['git', 'clone', '-q', '--no-checkout', bundle if bundle.is_file() else base, tree])
        for checkpoint in ('ep01-matched-tick', 'ep01-loop-30hz'):
            run(['git', '-C', tree, 'switch', '-q', '--detach', checkpoint])
            print(f'{checkpoint} | one frame at 15 FPS', flush=True)
            run([sys.executable, base / 'frame', '15', '--source', tree])
elif ep=='race':
    trials=[('ep01-single-step',30),('ep01-matched-tick',30),('ep01-matched-tick',15),
            ('ep01-loop-30hz',15),('ep01',15)]
    for checkpoint,fps in trials:
        print(f'\n{checkpoint} | {fps} vs 240 FPS',flush=True)
        run([sys.executable,base/'race',str(fps),'--version',checkpoint])
    run([sys.executable, __file__, 'frame'])
elif ep in ('pulse','clock'):
    middle='ep00-unused-elapsed' if ep=='pulse' else 'ep00-static-elapsed'
    tags=['.'] if args.source else ['ep00-frozen','ep00-fast',middle,'ep00']
    for tag in tags:
        print(f'\n{tag} | first clock = 0.20 s',flush=True)
        mode='pulse' if ep=='pulse' else 'arg'
        run([sys.executable,base/'probe',tag,mode,'--start-time','0.20'],cwd=args.source)
elif ep=='corners':
    origin=base/'silnik-3d.bundle' if (base/'silnik-3d.bundle').is_file() else base
    with TemporaryDirectory(prefix='cube-points-') as scratch:
        work=Path(scratch)
        repo=work/'ref'
        run(['git','clone','-q','--no-checkout',origin,repo])
        for tag in ('ep02-unused-draw', 'ep02-one-corner', 'ep02-stacked-corners', 'ep02-two-locations', 'ep02-flat', 'ep02-tilted-points'):
            run(['git','-C',repo,'switch','-q','--detach',tag])
            print(tag,flush=True)
            run(['c++','-std=c++17','-I',repo,base/'corner-trace.cpp','-o',work/'points'])
            run([work/'points'])

elif ep in ('edges','turns'):
    with TemporaryDirectory(prefix='cube-trace-') as scratch:
        work=Path(scratch)
        tree=work/'engine'
        if args.source:
            trials=[(str(args.source),args.source.resolve())]
        else:
            origin=base/'silnik-3d.bundle' if (base/'silnik-3d.bundle').is_file() else base
            run(['git','clone','-q','--no-checkout',origin,tree])
            tags=(('ep02-wire','ep02-turn-360','ep02-turn-degrees','ep02-turn-y','ep02-turn-z')
                  if ep=='turns' else ('ep02-marked-rings','ep02-crossed-sides','ep02-wire'))
            trials=[(tag,tree) for tag in tags]
        for label,source in trials:
            if not args.source:
                run(['git','-C',source,'switch','-q','--detach',label])
            print(label,flush=True)
            run(['c++','-std=c++17','-I',source,base/'edge-pairs.cpp','-o',work/'trace'])
            run([work/'trace','--corner-six'] if ep=='turns' else [work/'trace'])

else:
    for exercise in ('corners','edges','turns'):
        print(f'\n$ python3 replay {exercise}',flush=True)
        run([sys.executable,__file__,exercise])
    with TemporaryDirectory(prefix='silnik-test-') as work:
        repo=Path(work)/'silnik'
        run(['git','clone','-q',base,repo])
        for tag in ('ep02-euler','ep02-quat-euler','ep02'):
            print(f'\n$ git switch --detach {tag}',flush=True)
            run(['git','switch','-q','--detach',tag],repo)
            print('$ c++ -std=c++17 axes.cpp -o axes',flush=True)
            run(['c++','-std=c++17','axes.cpp','-o','axes'],repo)
            for angle in (('60','89','90') if tag=='ep02-euler' else ('90',)):
                print(f'$ ./axes {angle}',flush=True)
                run([repo/'axes',angle],repo)

    for tag in ('ep02-euler','ep02-quat-euler','ep02'):
        print(f'\n$ python3 steer {tag} --trace',flush=True)
        run([sys.executable,base/'steer',tag,'--trace'])
