#!/usr/bin/env python3
"""Run one deterministic native framebuffer or jump test against a film checkpoint."""
import argparse, os, shutil, subprocess as sp, tempfile
from pathlib import Path
base=Path(__file__).resolve().parent
parser=argparse.ArgumentParser()
parser.add_argument('version',help='Git tag (ep00-frozen, ep00, ep01-per-frame, ep01) or . for your current source')
parser.add_argument('rate',help='FPS, pixel for RGB, or arg for the angle passed to cos')
parser.add_argument('--frames',type=Path,help='write 192x108 RGB frames to this file')
args=parser.parse_args()
angle=args.rate=='arg'
pixel=args.rate in ('pixel','arg')
hz=30 if pixel else int(args.rate)
if not 1<=hz<=1000:parser.error('Use 1–1000 FPS.')
configured=os.environ.get('CMAKE_BIN_DIR')
installed=Path('/opt/homebrew/share/android-commandlinetools/cmake/3.22.1/bin')
if configured or (not all(shutil.which(x) for x in ('cmake','ninja')) and all((installed/x).is_file() for x in ('cmake','ninja'))):
    os.environ['PATH']=str(configured or installed)+os.pathsep+os.environ.get('PATH','')
def run(argv,**kw):return sp.run(argv,check=True,**kw)
with tempfile.TemporaryDirectory(prefix='cpp-engine-probe-') as tmp:
    tmp=Path(tmp)
    if args.version=='.':
        src=Path.cwd()
    else:
        src=tmp/'src'
        origin=base
        run(['git','clone','-q','--no-checkout',origin,src])
        run(['git','-C',src,'switch','-q','--detach',args.version])
    for f in ('main.cpp','frame.hpp','vendor/glfw'):
        if not (src/f).exists():parser.error('Checkpoint missing '+f)
    driver=tmp/'driver';driver.mkdir()
    shutil.copy(base/'sampler.cpp',driver)
    text=(src/'frame.hpp').read_text()
    if angle:
        import re
        wrapped,count=re.subn(r'std::cos\(([^()]*)\)',r'std::cos(probeArgument(\1))',text)
        if count!=1:parser.error('This checkpoint has no single cosine to trace.')
        shutil.copy(src/'main.cpp',driver)
        (driver/'frame.hpp').write_text(wrapped)
    defs='HAS_PLAYER HAS_PEAK' if 'double peak' in text else ('HAS_PLAYER' if 'struct Jumper' in text else '')
    (driver/'CMakeLists.txt').write_text('''cmake_minimum_required(VERSION 3.20)
project(FilmProbe LANGUAGES C CXX)
set(CMAKE_CXX_STANDARD 17)
set(GLFW_BUILD_EXAMPLES OFF)
set(GLFW_BUILD_TESTS OFF)
set(GLFW_BUILD_DOCS OFF)
add_subdirectory("${ENGINE}/vendor/glfw" glfw)
add_executable(probe sampler.cpp "${ENGINE}/vendor/glad/src/gl.c")
target_include_directories(probe PRIVATE "${ENGINE}" "${ENGINE}/vendor/glad/include")
target_link_libraries(probe PRIVATE glfw)
target_compile_definitions(probe PRIVATE '''+defs+''')
''')
    build=tmp/'build'
    run(['cmake','-S',driver,'-B',build,'-G','Ninja','-DENGINE='+str(src)],stdout=sp.DEVNULL)
    run(['cmake','--build',build],stdout=sp.DEVNULL)
    run([build/'probe',str(hz),str((1 if pixel else 2)*hz+1),'@' if pixel else str(args.frames.resolve()) if args.frames else '-'])
